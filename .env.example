

# SPIRE trust domain
TRUST_DOMAIN=spire.lab.acme
PROJECT_NAME=aegis
ENVIRONMENT=dev
# SPIRE server connection
SPIRE_SERVER_HOST=spire-server
SPIRE_SERVER_PORT=8081


# Workload API socket path.
# Must match the mount path defined in docker-compose.yml.
# URI form — used by py-spiffe and grpcurl
SPIFFE_ENDPOINT_SOCKET=unix:///tmp/spire-agent/public/api.sock

# Bare path — used by spire-agent CLI
SPIRE_SOCKET_PATH=/tmp/spire-agent/public/api.sock

# The SPIFFE ID this workload will present.
SPIFFE_ID=spiffe://spire.lab.acme/my-agent


# Selector used when registering the workload entry.
# On Docker Desktop with Git Bash, the caller is UID 0.
# Inside a container running as non-root, use unix:uid:1000.
SELECTOR=unix:uid:0


# Composition inputs. These are hashed into the attestation.
# Changing any value changes the composition hash and triggers
# drift detection on the next attestation cycle.


# Attestor behavior

# How often the attestor re-runs and checks for drift, in seconds.
ATTEST_INTERVAL_SECONDS=600

# Optional downstream target.
# If set, the attestor makes an mTLS call to this URL on each cycle.
# Leave empty for pure attestation mode.
TARGET_URL=


# Logging

# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

MSYS_NO_PATHCONV=1
# Compose and Makefile

# Project prefix used for volume names. Do not change after first run.
COMPOSE_PROJECT_NAME=agentic-identity



LISTEN_HOST=0.0.0.0
LISTEN_PORT=8443

PEER_PORT=8443
HANDSHAKE_TIMEOUT_S=5
POP_SKEW_S=30
REPLAY_TTL_S=300

TTL_OVERRIDE=60